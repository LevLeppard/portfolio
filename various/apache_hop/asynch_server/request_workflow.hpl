        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

header = JSON.stringify({"Content-Type": "application/json"});

body = JSON.stringify({
  "runConfiguration": "local"
});
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>body</name>
        <rename>body</rename>
        <type>String</type>
        <length>-1</length>
